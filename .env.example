# ========================================================
# MSA ORDER MANAGEMENT - BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

PORT=5000
NODE_ENV=development

# --------------------------------------------------------
# 1. SHOPIFY STORES CONFIGURATION
# --------------------------------------------------------
# Shopify Webhook Secret (from Shopify Admin > Settings > Notifications > Webhooks)
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Store 1 (Primary)
SHOPIFY_STORE_1_DOMAIN=yourstore.myshopify.com
SHOPIFY_STORE_1_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Store 2 (Optional)
SHOPIFY_STORE_2_DOMAIN=store2.myshopify.com
SHOPIFY_STORE_2_ACCESS_TOKEN=shpat_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# --------------------------------------------------------
# 2. COURIER APIS CONFIGURATION (PAKISTAN)
# --------------------------------------------------------

# POSTEX API (https://merchant.postex.pk)
POSTEX_ENV=sandbox # or production
POSTEX_TOKEN=your_postex_token_here
POSTEX_PICKUP_ADDRESS_ID=1

# TRAX LOGISTICS API (https://sonic.pk)
TRAX_ENV=sandbox # or production
TRAX_API_KEY=your_trax_api_key_here
TRAX_PICKUP_ADDRESS_ID=1

# LEOPARDS COURIER API (https://merchant.leopardscourier.com)
LEOPARDS_ENV=sandbox # or production
LEOPARDS_API_KEY=your_leopards_api_key_here
LEOPARDS_API_PASSWORD=your_leopards_api_password_here
LEOPARDS_SHIPPER_ID=12345
